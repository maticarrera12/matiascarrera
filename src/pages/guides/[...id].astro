---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import GuidePagination from "../../components/GuidePagination.astro";
import { navigationTree } from "../../config/navigation";
import {
	flattenSeries,
	getLessonNavigation,
	getSerieForGuideId,
	resolveGuideNavLinks,
} from "../../helpers/flattenSerie";
import type { GuideNavLink } from "../../helpers/flattenSerie";
import MountainHero from "../../components/MountainHero.astro";

export async function getStaticPaths() {
	const guides = await getCollection("guides");
	const guideIds = guides.map((entry) => entry.id);
	const lessons = flattenSeries(navigationTree);

	return guides.map((guide) => {
		const navigation = getLessonNavigation(lessons, guide.id);
		const { previous, next } = resolveGuideNavLinks(navigation, guideIds);
		const serie = getSerieForGuideId(guide.id, navigationTree);

		return {
			params: { id: guide.id },
			props: {
				guide,
				previous,
				next,
				accentColor: serie?.color ?? "#E44D26",
			},
		};
	});
}

interface Props {
	guide: Awaited<ReturnType<typeof getCollection<"guides">>>[number];
	previous: GuideNavLink | null;
	next: GuideNavLink | null;
	accentColor: string;
}

const { guide, previous, next, accentColor } = Astro.props;
const { title, subtitle } = guide.data;
const { Content } = await render(guide);
---

<Layout title={`${title} · Matías Carrera`} description={subtitle}>
	<main class={`--guide-accent: ${accentColor}`}>
		<MountainHero>
			<header class="mb-12 text-center">
				<h1
					class="text-4xl font-bold leading-tight text-foreground md:text-8xl"
				>
					{title}
				</h1>
				<p class="mt-4 text-xl leading-relaxed text-muted">
					{subtitle}
				</p>
			</header>
		</MountainHero>
		<div>
			<div class="mx-auto w-full max-w-3xl">
				<article class="content-defaults">
					<Content />
				</article>

				<GuidePagination
					accentColor={accentColor}
					previous={previous}
					next={next}
				/>
			</div>
		</div>
	</main>
</Layout>
