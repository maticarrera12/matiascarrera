---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import GalleryLightbox from '@/components/GalleryLightbox.astro';
import Layout from '@/layouts/Layout.astro';
import { AUTHOR } from '@/const';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const {
	title,
	description,
	cover,
	stack,
	repo,
	demo,
	overview,
	problem,
	solution,
	architecture,
	learning,
	learningList,
	features,
	gallery,
	architectureImage,
} = project.data;

const featureEntries = features ? Object.entries(features) : [];
const galleryImages = gallery.length > 0 ? gallery : [];
const architectureImageUrl = architectureImage ? architectureImage : '';
---

<Layout title={`${title} · Matías Carrera`} description={description} ogImage={cover}>
	<article class="min-h-screen bg-background pt-24 pb-0">
		<nav class="container mb-10" aria-label="Navegación del proyecto">
			<a
				href="/#proyectos"
				class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground"
			>
				<Icon
					name="lucide:arrow-left"
					class="size-4 transition-all duration-300 group-hover:-translate-x-1"
					aria-hidden="true"
				/>
				Volver a Proyectos
			</a>
		</nav>

		<section class="container mb-24" aria-labelledby="project-title">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<header class="flex flex-col gap-6">
					<h1
						id="project-title"
						class="text-5xl font-bold leading-tight text-foreground md:text-7xl"
					>
						{title}
					</h1>

					<p class="text-base leading-relaxed text-slate-400 md:text-lg">
						{description}
					</p>

					<ul
						class="m-0 flex list-none flex-wrap gap-2 p-0"
						aria-label="Stack tecnológico"
					>
						{
							stack.map((tech) => (
								<li>
									<span class="rounded-lg border border-zinc-700 bg-zinc-100 px-3 py-1 text-sm text-foreground dark:bg-zinc-900">
										{tech}
									</span>
								</li>
							))
						}
					</ul>

					<nav aria-label="Enlaces del proyecto" class="pt-2">
						<ul class="m-0 flex list-none flex-wrap gap-3 p-0">
							{
								demo && (
									<li>
										<a
											href={demo}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
										>
											Ver demo
											<Icon
												name="lucide:external-link"
												class="size-4"
												aria-hidden="true"
											/>
										</a>
									</li>
								)
							}
							{
								repo && (
									<li>
										<a
											href={repo}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-2 rounded-lg border border-zinc-900 bg-zinc-700 px-5 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:text-white"
										>
											Ver repositorio
											<Icon
												name="lucide:github"
												class="size-4"
												aria-hidden="true"
											/>
										</a>
									</li>
								)
							}
						</ul>
					</nav>
				</header>

				<figure class="relative m-0">
					<div
						class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/50"
					>
						<img
							src={cover}
							alt={'Captura de ' + title}
							width={800}
							height={500}
							class="aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
						/>
					</div>
					<div
						class="pointer-events-none absolute -inset-4 -z-10 rounded-3xl bg-primary/5 blur-2xl"
						aria-hidden="true"
					>
					</div>
				</figure>
			</div>
		</section>

		<section class="container mb-24" aria-label="Resumen del proyecto">
			<ul
				class="m-0 flex list-none flex-col gap-10 p-0 md:flex-row md:items-stretch md:gap-8"
			>
				<li class="min-w-0 flex-1">
					<section aria-labelledby="project-overview">
						<h2
							id="project-overview"
							class="text-xs font-bold uppercase tracking-widest text-primary"
						>
							Overview
						</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							{overview}
						</p>
					</section>
				</li>
				<li class="min-w-0 flex-1">
					<section aria-labelledby="project-problem">
						<h2
							id="project-problem"
							class="text-xs font-bold uppercase tracking-widest text-primary"
						>
							Problema
						</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							{problem}
						</p>
					</section>
				</li>
				<li class="min-w-0 flex-1">
					<section aria-labelledby="project-solution">
						<h2
							id="project-solution"
							class="text-xs font-bold uppercase tracking-widest text-primary"
						>
							Mi Solución
						</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">
							{solution}
						</p>
					</section>
				</li>
			</ul>
		</section>

		<div class="container">
			<hr class="h-px w-full border-0 bg-zinc-800" />
		</div>

		<section class="container py-20" aria-labelledby="project-stack">
			<h2
				id="project-stack"
				class="mb-8 text-xs font-bold uppercase tracking-widest text-primary"
			>
				Tecnologías
			</h2>
			<div class="overflow-x-auto">
				<ul
					class="m-0 flex w-max list-none flex-wrap items-center gap-x-8 gap-y-2 p-0"
					role="list"
				>
					{
						stack.map((tech) => (
							<li>
								<span class="text-md font-medium text-muted">{tech}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<div class="container">
			<hr class="h-px w-full border-0 bg-zinc-800" />
		</div>

		<section class="container py-20" aria-labelledby="project-architecture">
			<h2
				id="project-architecture"
				class="mb-8 text-xs font-bold uppercase tracking-widest text-primary"
			>
				Arquitectura
			</h2>
			<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
				<div class="flex flex-col justify-center gap-3">
					{
						architecture.split('. ').filter(Boolean).map((sentence) => (
							<p class="text-sm leading-relaxed text-slate-400">
								{sentence}
							</p>
						))
					}
				</div>

				{
					architectureImageUrl && (
						<figure
							class="m-0 flex items-center justify-center rounded-xl border border-zinc-100 dark:border-zinc-800"
						>
							<img
								src={architectureImageUrl}
								alt={`Diagrama de arquitectura de ${title}`}
								class="h-full w-full object-contain"
							/>
						</figure>
					)
				}
			</div>
		</section>

		{
			featureEntries.length > 0 && (
				<div class="container">
					<hr class="h-px w-full border-0 bg-zinc-800" />
				</div>
			)
		}
		{
			featureEntries.length > 0 && (
				<section
					class="container py-20"
					aria-labelledby="project-features"
				>
					<h2
						id="project-features"
						class="mb-8 text-xs font-bold uppercase tracking-widest text-primary"
					>
						Funcionalidades Principales
					</h2>
					<ul class="m-0 grid list-none grid-cols-2 gap-4 p-0 lg:grid-cols-4">
						{
							featureEntries.map(([name, desc]) => (
								<li class="flex flex-col gap-2 rounded-xl p-5 transition-colors">
									<h3 class="text-sm font-semibold text-foreground">
										{name}
									</h3>
									<p class="text-xs leading-relaxed text-slate-500">
										{desc}
									</p>
								</li>
							))
						}
					</ul>
				</section>
			)
		}

		{
			galleryImages.length > 0 && (
				<>
					<div class="container">
						<hr class="h-px w-full border-0 bg-zinc-800" />
					</div>
					<section class="container py-20" aria-labelledby="project-gallery">
						<h2
							id="project-gallery"
							class="mb-8 text-xs font-bold uppercase tracking-widest text-primary"
						>
							Capturas
						</h2>
						<GalleryLightbox images={galleryImages} title={title} />
					</section>
				</>
			)
		}

		<div class="container">
			<hr class="h-px w-full border-0 bg-zinc-800" />
		</div>

		<section class="container py-20" aria-labelledby="project-learning">
			<h2
				id="project-learning"
				class="mb-8 text-xs font-bold uppercase tracking-widest text-primary"
			>
				Qué aprendí
			</h2>
			<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
				<p class="text-sm leading-relaxed text-muted-foreground">{learning}</p>
				{
					learningList.length > 0 && (
						<ul class="m-0 flex list-none flex-col gap-3 p-0">
							{
								learningList.map((item) => (
									<li class="flex items-center gap-3 text-sm text-slate-400">
										<Icon
											name="lucide:check-circle"
											class="size-4 shrink-0 text-primary"
											aria-hidden="true"
										/>
										{item}
									</li>
								))
							}
						</ul>
					)
				}
			</div>
		</section>

		<section class="mt-8" aria-labelledby="project-cta">
			<div
				class="mx-auto flex flex-col items-center justify-between gap-6 px-8 py-16 text-center sm:flex-row sm:text-left lg:px-24"
			>
				<header>
					<h2
						id="project-cta"
						class="text-2xl font-bold text-foreground md:text-3xl"
					>
						¿Tenés un proyecto en mente?
					</h2>
					<p class="mt-2 text-sm text-slate-400">
						Estoy disponible para trabajar en nuevos desafíos.
					</p>
				</header>
				<a
					href={`mailto:${AUTHOR.email}?subject=Proyecto:`}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
				>
					Hablemos
					<Icon
						name="lucide:arrow-right"
						class="size-4"
						aria-hidden="true"
					/>
				</a>
			</div>
		</section>
	</article>
</Layout>
