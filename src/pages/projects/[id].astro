---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const {
	title,
	type,
	description,
	cover,
	stack,
	repo,
	demo,
	status,
	featured,
	overview,
	problem,
	solution,
	architecture,
	learning,
	learningList,
	features,
	gallery,
	architectureImage,
} = project.data;

const featureEntries = features ? Object.entries(features) : [];
const galleryImages = gallery.length > 0 ? gallery : [];
const architectureImageUrl = architectureImage ? architectureImage : '';
const featureIcons = [
	'lucide:users',
	'lucide:list',
	'lucide:map',
	'lucide:message-circle',
	'lucide:bookmark',
	'lucide:clock',
	'lucide:trophy',
	'lucide:credit-card',
	'lucide:search',
	'lucide:settings',
	'lucide:globe',
	'lucide:mail',
	'lucide:bell',
	'lucide:bar-chart',
	'lucide:shield',
];

const techIconMap: Record<string, string> = {
	'Next.js': '/images/tecnologies/Next-js_Symbol_1.png',
	React: '/images/tecnologies/reactjs.png',
	TypeScript: '/images/tecnologies/typescript.webp',
	PostgreSQL: '/images/tecnologies/postgresql.webp',
	'Spring Boot': '/images/tecnologies/springboot.webp',
	Astro: '/images/tecnologies/astro.png',
};

let statusDot = 'bg-zinc-500';
let statusGlow = 'bg-zinc-500/40';
if (status === 'active') {
	statusDot = 'bg-emerald-400';
	statusGlow = 'bg-emerald-400/50';
} else if (status === 'in-progress') {
	statusDot = 'bg-amber-400';
	statusGlow = 'bg-amber-400/50';
}
---

<Layout>
	<main class="min-h-screen bg-background pt-24 pb-0">
		<!-- Back link -->
		<div class="container mb-10">
			<a
				href="/#proyectos"
				class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground group"
			>
				<Icon name="lucide:arrow-left" class="size-4 transition-all  group-hover:-translate-x-1 duration-300" />
				Volver a Proyectos
			</a>
		</div>

		<!-- Hero -->
		<section class="container mb-24">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<!-- Left -->
				<div class="flex flex-col gap-6">
							<!-- <div class="flex items-center gap-2">
								<span class="relative flex size-2 shrink-0" aria-hidden="true">
									<span
										class={'absolute -inset-1 animate-pulse rounded-full blur-sm ' +
											statusGlow}
									></span>
									<span class={'relative size-2 rounded-full ' + statusDot}></span>
								</span>
								<span class="text-xs font-bold uppercase tracking-widest text-primary">
									{featured ? 'Proyecto Destacado' : 'Proyecto'}
								</span>
							</div> -->

					<h1 class="text-5xl font-bold leading-tight text-foreground md:text-7xl">
						{title}
					</h1>

					<p class="text-base leading-relaxed text-slate-400 md:text-lg">
						{description}
					</p>

					<div class="flex flex-wrap gap-2">
						{
							stack.map((tech) => (
								<span class="rounded-lg border border-zinc-700 bg-zinc-100 dark:bg-zinc-900 px-3 py-1 text-sm text-foreground">
									{tech}
								</span>
							))
						}
					</div>

					<div class="flex flex-wrap gap-3 pt-2">
						{
							demo && (
								<a
									href={demo}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
								>
									Ver demo
									<Icon name="lucide:external-link" class="size-4" />
								</a>
							)
						}
						{
							repo && (
								<a
									href={repo}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 rounded-lg border border-zinc-900 bg-zinc-700 px-5 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:text-white"
								>
									Ver repositorio
									<Icon name="lucide:github" class="size-4" />
								</a>
							)
						}
					</div>
				</div>

				<!-- Right: cover image -->
				<div class="relative">
					<div
						class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/50"
					>
						<img
							src={cover}
							alt={'Captura de ' + title}
							width={800}
							height={500}
							class="aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
						/>
					</div>
					<div
						class="pointer-events-none absolute -inset-4 -z-10 rounded-3xl bg-primary/5 blur-2xl"
					>
					</div>
				</div>
			</div>
		</section>

		<!-- Overview / Problema / Solución -->
		<section class="container mb-24">
			<ul class="m-0 flex list-none flex-col gap-10 p-0 md:flex-row md:items-stretch md:gap-0">
				<li class="min-w-0 flex-1">
					<div class="flex flex-col gap-3 md:pe-8">
						<span class="text-xs font-bold uppercase tracking-widest text-primary"
							>Overview</span
						>
						<p class="text-sm leading-relaxed text-slate-400">{overview}</p>
					</div>
				</li>
				<li class="bar-vdivider max-md:hidden" aria-hidden="true"></li>
				<li class="min-w-0 flex-1">
					<div class="flex flex-col gap-3 md:px-8">
						<span class="text-xs font-bold uppercase tracking-widest text-primary"
							>Problema</span
						>
						<p class="text-sm leading-relaxed text-slate-400">{problem}</p>
					</div>
				</li>
				<li class="bar-vdivider max-md:hidden" aria-hidden="true"></li>
				<li class="min-w-0 flex-1">
					<div class="flex flex-col gap-3 md:ps-8">
						<span class="text-xs font-bold uppercase tracking-widest text-primary"
							>Mi Solución</span
						>
						<p class="text-sm leading-relaxed text-slate-400">{solution}</p>
					</div>
				</li>
			</ul>
		</section>

		<!-- Divider -->
		<div class="container">
			<div class="h-px w-full bg-zinc-800"></div>
		</div>

		<!-- Tecnologías -->
		<section class="container py-20">
			<span class="mb-8 block text-xs font-bold uppercase tracking-widest text-primary"
				>Tecnologías</span
			>
			<div class="flex flex-wrap gap-8">
				{
					stack.map((tech) => {
						const img = techIconMap[tech];
						return (
							<div class="flex items-center gap-2 rounded-xl">
								{img ? (
									<img src={img} alt={tech} class="size-8 object-contain" />
								) : (
									<span class="flex size-8 items-center justify-center rounded-sm text-xs font-bold text-foreground">
										{tech[0]}
									</span>
								)}
								<span class="text-md font-medium text-muted">{tech}</span>
							</div>
						);
					})
				}
			</div>
		</section>

		<!-- Divider -->
		<div class="container">
			<div class="h-px w-full bg-zinc-800"></div>
		</div>

		<!-- Arquitectura -->
		<section class="container py-20">
			<span class="mb-8 block text-xs font-bold uppercase tracking-widest text-primary"
				>Arquitectura</span
			>
			<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
				<div class="flex flex-col justify-center gap-3">
					{
						architecture.split('. ').filter(Boolean).map((sentence) => (
							<p class="text-sm leading-relaxed text-slate-400">{sentence }</p>
						))
					}
				</div>

				<!-- Visual diagram -->
				<div
					class="flex items-center justify-center rounded-xl border dark:border-zinc-800 border-zinc-100 "
				>
					{architectureImageUrl && (
						<img src={architectureImageUrl} alt="Arquitectura" class="rounded-xl w-full h-full object-contain" />
					)}
				</div>
			</div>
		</section>

		<!-- Funcionalidades -->
		{featureEntries.length > 0 && (
			<div class="container">
				<div class="h-px w-full bg-zinc-800"></div>
			</div>
		)}
		{featureEntries.length > 0 && (
			<section class="container py-20">
				<span class="mb-8 block text-xs font-bold uppercase tracking-widest text-primary">
					Funcionalidades Principales
				</span>
				<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
					{featureEntries.map(([name, desc]) => (
						<div class="flex flex-col gap-2 rounded-xl p-5 transition-colors">
							<h3 class="text-sm font-semibold text-foreground">{name}</h3>
							<p class="text-xs leading-relaxed text-slate-500">{desc}</p>
						</div>
					))}
				</div>
			</section>
		)}

		{
			galleryImages.length > 0 && (
				<>
					<div class="container">
						<div class="h-px w-full bg-zinc-800"></div>
					</div>
					<section class="container py-20">
						<span class="mb-8 block text-xs font-bold uppercase tracking-widest text-primary">
							Capturas
						</span>
						<GalleryLightbox images={galleryImages} title={title} />
					</section>
				</>
			)
		}

		<!-- Divider -->
		<div class="container">
			<div class="h-px w-full bg-zinc-800"></div>
		</div>

		<!-- Qué aprendí -->
		<section class="container py-20">
			<span class="mb-8 block text-xs font-bold uppercase tracking-widest text-primary"
				>Qué aprendí</span
			>
			<div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
				<p class="text-sm leading-relaxed text-muted-foreground">{learning}</p>
				{
					learningList.length > 0 && (
						<ul class="flex flex-col gap-3">
							{learningList.map((item) => (
								<li class="flex items-center gap-3 text-sm text-slate-400">
									<Icon
										name="lucide:check-circle"
										class="size-4 shrink-0 text-primary"
									/>
									{item}
								</li>
							))}
						</ul>
					)
				}
			</div>
		</section>

		<!-- CTA -->
		<section class="mt-8">
			<div
				class="mx-auto flex flex-col items-center justify-between gap-6 px-8 py-16 text-center sm:flex-row sm:text-left lg:px-24"
			>
				<div>
					<h2 class="text-2xl font-bold text-foreground md:text-3xl">
						¿Tenés un proyecto en mente?
					</h2>
					<p class="mt-2 text-sm text-slate-400">
						Estoy disponible para trabajar en nuevos desafíos.
					</p>
				</div>
				<a
					href="mailto:mcarreradev12@gmail.com?subject=Proyecto:"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
				>
					Hablemos
					<Icon name="lucide:arrow-right" class="size-4" />
				</a>
			</div>
		</section>
	</main>
</Layout>
