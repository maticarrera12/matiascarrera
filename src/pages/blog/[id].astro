---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MountainHero from '../../components/MountainHero.astro';
import PostPagination from '../../components/PostPagination.astro';

const dateOptions = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const posts = allPosts.sort(
		(a, b) => a.data.publishedAt.valueOf() - b.data.publishedAt.valueOf(),
	);

	return posts.map((post, index) => ({
		params: { id: post.id },
		props: {
			post,
			prevPost: index > 0 ? posts[index - 1] : null,
			nextPost: index < posts.length - 1 ? posts[index + 1] : null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const h2Headings = headings
	.filter((h) => h.depth === 2)
	.map(({ depth, slug: id, text }) => ({ depth, id, text }));
---

<Layout title={`${post.data.title} · Matías Carrera`} description={post.data.description}>
	<!-- Hero with mountains: title, description, meta -->
	<MountainHero align="start">
		<div class="flex flex-col gap-6 text-left mt-24">
			{
				post.data.tags.length > 0 && (
					<div class="flex flex-wrap justify-start gap-2">
						{post.data.tags.map((tag) => (
							<span class="text-xs font-bold uppercase tracking-widest text-primary/80">
								#{tag}
							</span>
						))}
					</div>
				)
			}

			<h1 class="text-4xl font-bold leading-tight text-foreground">
				{post.data.title}
			</h1>

			<p class="text-lg text-muted">
				{post.data.description}
			</p>

			<div class="flex items-center gap-3 text-sm text-muted">
				<span aria-hidden="true">·</span>
				<time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
					{post.data.publishedAt.toLocaleDateString('es-AR', dateOptions)}
				</time>
				{
					post.data.readingTime && (
						<>
							<span aria-hidden="true">·</span>
							<span>{post.data.readingTime} min de lectura</span>
						</>
					)
				}
			</div>
		</div>
	</MountainHero>

	<!-- Post content + TOC -->
	<div class="container py-12">
		<div class="post-layout">
			<!-- Main content -->
			<article class="post-body prose min-w-0">
				<Content />
			</article>

			<!-- TOC sidebar: hidden on mobile/tablet, sticky on desktop -->
			{
				h2Headings.length > 0 && (
					<aside class="post-toc hidden lg:block" aria-label="Tabla de contenidos">
						<nav>
							<p class="toc-title mb-4 text-xs font-bold uppercase tracking-widest text-muted">
								Contenidos
							</p>
							<ol class="m-0 list-none p-0 flex flex-col gap-1">
								{h2Headings.map((heading) => (
									<li>
										<a
											href={`#${heading.id}`}
											class="toc-link"
											data-toc-id={heading.id}
										>
											{heading.text}
										</a>
									</li>
								))}
							</ol>
						</nav>
					</aside>
				)
			}
		</div>

		<PostPagination prevPost={prevPost} nextPost={nextPost} />
	</div>
</Layout>

<style is:global>
	/* Post two-column layout */
	.post-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.post-layout {
			grid-template-columns: minmax(0, 720px) 200px;
		}
	}

	/* TOC sidebar */
	.post-toc {
		position: sticky;
		top: 5.5rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
	}

	.toc-link {
		display: block;
		padding: 0.375rem 0.75rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-gray-700);
		text-decoration: none;
		border-left: 2px solid transparent;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.toc-link:hover {
		color: var(--color-text);
	}

	.toc-link.toc-active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-link {
			transition: none;
		}
	}

	/* ── Prose: article typography ────────────────────────────────────── */

	.post-body {
		/* Override Tailwind Typography prose color variables */
		--tw-prose-body: var(--color-text);
		--tw-prose-headings: var(--color-text);
		--tw-prose-lead: var(--color-gray-700);
		--tw-prose-links: var(--color-primary);
		--tw-prose-bold: var(--color-text);
		--tw-prose-counters: var(--color-gray-700);
		--tw-prose-bullets: var(--color-gray-700);
		--tw-prose-hr: var(--color-gray-300);
		--tw-prose-quotes: var(--color-text);
		--tw-prose-quote-borders: var(--color-primary);
		--tw-prose-captions: var(--color-gray-700);
		--tw-prose-code: var(--color-primary);
		--tw-prose-pre-code: var(--color-text);
		--tw-prose-pre-bg: var(--color-cloud-500);
		--tw-prose-th-borders: var(--color-gray-300);
		--tw-prose-td-borders: var(--color-gray-300);
		max-width: none;
	}

	/* Line height and paragraph spacing */
	.post-body p {
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	/* H2 hierarchy */
	.post-body h2 {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.3;
		margin-top: 3.5rem;
		margin-bottom: 1rem;
		color: var(--color-text);
	}

	/* Links */
	.post-body a {
		color: var(--color-primary);
		text-decoration: none;
		transition: text-decoration-color 0.2s ease;
	}

	.post-body a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-primary);
	}

	/* Blockquote */
	.post-body blockquote {
		border-left: 3px solid var(--color-primary);
		background: transparent;
		padding: 0.5rem 0 0.5rem 1.5rem;
		margin: 2rem 0;
		font-style: italic;
		color: var(--color-gray-700);
	}

	.post-body blockquote p {
		margin: 0;
	}

	/* Images */
	.post-body img {
		border-radius: 0.75rem;
		width: 100%;
		height: auto;
	}

	/* Shiki code blocks */
	.post-body .astro-code {
		border-radius: 0.75rem;
		padding: 1.25rem 1.5rem;
		font-size: 0.875rem;
		line-height: 1.7;
		overflow-x: auto;
		margin: 2rem 0;
	}

	/* Inline code */
	.post-body :not(pre) > code {
		background: var(--color-cloud-500);
		color: var(--color-primary);
		padding: 0.15rem 0.4rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}

	/* Lists */
	.post-body ul,
	.post-body ol {
		padding-left: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.post-body li {
		margin-bottom: 0.5rem;
		line-height: 1.7;
		color: var(--color-text);
	}

	/* Bold */
	.post-body strong {
		font-weight: 700;
		color: var(--color-text);
	}

	/* HR */
	.post-body hr {
		border-color: var(--color-gray-300);
		margin: 3rem 0;
		opacity: 0.4;
	}

	/* figure/figcaption from Figure component */
	.post-body figure {
		margin: 2rem 0;
	}

	.post-body figcaption {
		text-align: center;
		font-size: 0.875rem;
		color: var(--color-gray-700);
		margin-top: 0.625rem;
		font-style: italic;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-body a {
			transition: none;
		}
	}

</style>

<script>
	(function () {
		const headings = [
			...document.querySelectorAll<HTMLHeadingElement>('.post-body h2[id]'),
		];
		const links = [
			...document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]'),
		];

		if (!headings.length || !links.length) return;

		function setActive(id: string | null) {
			links.forEach((l) => {
				const isActive = l.dataset.tocId === id;
				l.classList.toggle('toc-active', isActive);
			});
		}

		// Activate first heading on load
		setActive(headings[0].id);

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActive(entry.target.id);
					}
				});
			},
			{
				// Top offset: 80px for fixed nav; bottom: only top 30% of viewport triggers
				rootMargin: '-80px 0px -70% 0px',
				threshold: 0,
			},
		);

		headings.forEach((h) => observer.observe(h));
	})();
</script>
