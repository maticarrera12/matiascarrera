---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MountainHero from '../../components/MountainHero.astro';
import PostPagination from '../../components/PostPagination.astro';

const dateOptions = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;

export async function getStaticPaths() {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const posts = allPosts.sort(
		(a, b) => a.data.publishedAt.valueOf() - b.data.publishedAt.valueOf(),
	);

	return posts.map((post, index) => ({
		params: { id: post.id },
		props: {
			post,
			prevPost: index > 0 ? posts[index - 1] : null,
			nextPost: index < posts.length - 1 ? posts[index + 1] : null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const h2Headings = headings
	.filter((h) => h.depth === 2)
	.map(({ depth, slug: id, text }) => ({ depth, id, text }));
---

<Layout title={`${post.data.title} · Matías Carrera`} description={post.data.description}>
	<!-- Hero with mountains: title, description, meta -->
	<MountainHero align="start">
		<header class="mt-24 flex flex-col gap-6 text-left">
			{
				post.data.tags.length > 0 && (
					<ul class="m-0 flex list-none flex-wrap justify-start gap-2 p-0">
						{post.data.tags.map((tag) => (
							<li>
								<span class="text-xs font-bold uppercase tracking-widest text-primary/80">
									#{tag}
								</span>
							</li>
						))}
					</ul>
				)
			}

			<h1 class="text-4xl font-bold leading-tight text-foreground">
				{post.data.title}
			</h1>

			<p class="text-lg text-muted">
				{post.data.description}
			</p>

			<p class="flex items-center gap-3 text-sm text-muted">
				<time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
					{post.data.publishedAt.toLocaleDateString('es-AR', dateOptions)}
				</time>
				{
					post.data.readingTime && (
						<>
							<span aria-hidden="true">·</span>
							<span>{post.data.readingTime} min de lectura</span>
						</>
					)
				}
			</p>
		</header>
	</MountainHero>

	<!-- Post content + TOC -->
	<div class="container py-12">
		<div class="post-layout">
			<article class="post-body prose min-w-0">
				<Content />
			</article>

			{
				h2Headings.length > 0 && (
					<aside class="post-toc hidden lg:block" aria-label="Tabla de contenidos">
						<nav aria-labelledby="toc-heading">
							<h2
								id="toc-heading"
								class="toc-title mb-4 text-xs font-bold uppercase tracking-widest text-muted"
							>
								Contenidos
							</h2>
							<ol class="m-0 list-none p-0 flex flex-col gap-1">
								{h2Headings.map((heading) => (
									<li>
										<a
											href={`#${heading.id}`}
											class="toc-link"
											data-toc-id={heading.id}
										>
											{heading.text}
										</a>
									</li>
								))}
							</ol>
						</nav>
					</aside>
				)
			}
		</div>

		<PostPagination prevPost={prevPost} nextPost={nextPost} />
	</div>
</Layout>

<style is:global>
	/* Post two-column layout */
	.post-layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: start;
	}

	@media (min-width: 1024px) {
		.post-layout {
			grid-template-columns: minmax(0, 720px) 200px;
		}
	}

	/* TOC sidebar */
	.post-toc {
		position: sticky;
		top: 5.5rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
	}

	.toc-link {
		display: block;
		padding: 0.375rem 0.75rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-gray-700);
		text-decoration: none;
		border-left: 2px solid transparent;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.toc-link:hover {
		color: var(--color-text);
	}

	.toc-link.toc-active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-link {
			transition: none;
		}
	}

	/* ── Prose: shared in src/styles/prose.css ─────────────────────────── */

</style>

<script>
	function initToc() {
		const headings = [
			...document.querySelectorAll<HTMLHeadingElement>('.post-body h2[id]'),
		];
		const links = [
			...document.querySelectorAll<HTMLAnchorElement>('[data-toc-id]'),
		];

		if (!headings.length || !links.length) return;

		function setActive(id: string | null) {
			links.forEach((l) => {
				const isActive = l.dataset.tocId === id;
				l.classList.toggle('toc-active', isActive);
			});
		}

		setActive(headings[0].id);

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActive(entry.target.id);
					}
				});
			},
			{
				rootMargin: '-80px 0px -70% 0px',
				threshold: 0,
			},
		);

		headings.forEach((h) => observer.observe(h));
	}

	document.addEventListener('astro:page-load', initToc);
</script>
