---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import MountainHero from '@/components/MountainHero.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const dateOptions = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;
---

<Layout
	title="Blog · Matías Carrera"
	description="Desarrollo web, diseño y aprendizaje en público."
>
	<MountainHero align="start">
		<header class="mt-24 text-left">
			<p
				class="mb-4 text-xs font-bold uppercase tracking-widest text-primary"
			>
				Blog
			</p>
			<h1 class="text-5xl font-bold text-foreground lg:text-7xl">
				Entre interfaces y código
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-muted">
				Estoy reconstruyendo mis fundamentos en plena era IA
			</p>
		</header>
	</MountainHero>

	<section class="container" aria-label="Listado de posts">
		{
			posts.length === 0 ? (
				<p class="text-muted">No hay posts publicados todavía.</p>
			) : (
				<ul class="m-0 flex list-none flex-col divide-y divide-border/40 p-0">
					{posts.map((post) => (
						<li>
							<article
								class="post-card"
								aria-labelledby={`post-${post.id}-title`}
							>
								<a
									href={`/blog/${post.id}`}
									class="group flex flex-col gap-4 py-10 transition-colors"
								>
									{post.data.tags.length > 0 && (
										<ul class="m-0 flex list-none flex-wrap gap-2 p-0">
											{post.data.tags.map((tag) => (
												<li>
													<span class="post-tag text-xs font-semibold uppercase tracking-wider text-primary/70">
														#{tag}
													</span>
												</li>
											))}
										</ul>
									)}

									<h2
										id={`post-${post.id}-title`}
										class="text-2xl font-bold text-foreground transition-colors group-hover:text-primary lg:text-3xl"
									>
										{post.data.title}
									</h2>

									<p class="text-base leading-relaxed text-muted">
										{post.data.description}
									</p>

									<footer class="flex items-center gap-3 text-sm text-muted">
										<time
											datetime={post.data.publishedAt
												.toISOString()
												.slice(0, 10)}
										>
											{post.data.publishedAt.toLocaleDateString(
												'es-AR',
												dateOptions,
											)}
										</time>
										{post.data.readingTime && (
											<>
												<span aria-hidden="true">·</span>
												<span>
													{post.data.readingTime} min de lectura
												</span>
											</>
										)}
									</footer>
								</a>
							</article>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Layout>

<style>
	.post-card:hover h2 {
		color: var(--color-primary);
	}
</style>
