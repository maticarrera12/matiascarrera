---
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	icon: string;
	label: string;
}

const { href, icon, label } = Astro.props;
const isExternal = href.startsWith('http');
---

<a
	href={href}
	class="social-button hidden md:inline-flex group relative size-15 shrink-0 items-center justify-center overflow-hidden rounded-md border border-foreground/70 font-semibold"
	aria-label={label}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
>
	<span
		class="absolute inset-0 origin-bottom scale-y-0 bg-primary transition-transform duration-300 ease-out group-hover:scale-y-100 group-focus-visible:scale-y-100"
		aria-hidden="true"
	></span>
	<Icon
		is:inline
		name={icon}
		class="relative z-10 size-5 text-foreground/70 transition-colors duration-300 ease-out group-hover:text-white group-focus-visible:text-white"
		aria-hidden="true"
	/>
</a>

<style>
	@media (prefers-reduced-motion: reduce) {
		.social-button span {
			transition: none;
		}
		.social-button:hover span,
		.social-button:focus-visible span {
			transform: scaleY(1);
		}
	}
</style>
