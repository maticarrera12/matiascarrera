---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	sample: CollectionEntry<'samples'>;
}

const { sample } = Astro.props;
const { title, kind, description, stack, url, status, image, beforeImage } =
	sample.data;

const STATUS = {
	live: { label: 'En producción', dot: 'bg-emerald-400', glow: 'bg-emerald-400/50' },
	'pre-launch': { label: 'Pre-lanzamiento', dot: 'bg-amber-400', glow: 'bg-amber-400/50' },
} as const;
const statusInfo = STATUS[status];

// Card is a link only when there is a live URL to visit.
const Wrapper = url ? 'a' : 'div';
const wrapperProps = url
	? { href: url, target: '_blank', rel: 'noopener noreferrer' }
	: {};
---

<article
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-cloud-100 transition-colors duration-300 hover:border-border/60"
	aria-labelledby={`sample-${sample.id}-title`}
>
	<Wrapper
		{...wrapperProps}
		class="flex h-full min-h-0 flex-col outline-offset-4 focus-visible:outline-2 focus-visible:outline-primary"
	>
		{
			image && beforeImage && (
				<figure class="relative m-0 overflow-hidden">
					<img
						src={image}
						alt={`${title}: rediseño del sitio`}
						width={1600}
						height={1000}
						class="aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
						loading="lazy"
					/>
					<figcaption class="absolute top-3 left-3 rounded-md bg-primary px-2 py-0.5 text-xs font-semibold text-white">
						Después
					</figcaption>
					<div class="absolute right-3 bottom-3 w-[34%] overflow-hidden rounded-lg border border-border shadow-lg">
						<img
							src={beforeImage}
							alt={`${title}: versión anterior del sitio`}
							width={1600}
							height={1000}
							class="aspect-16/10 w-full object-cover object-top"
							loading="lazy"
						/>
						<span class="absolute top-1.5 left-1.5 rounded bg-background/90 px-1.5 py-0.5 text-[10px] font-semibold text-foreground">
							Antes
						</span>
					</div>
				</figure>
			)
		}
		{
			image && !beforeImage && (
				<figure class="m-0 overflow-hidden">
					<img
						src={image}
						alt={`Captura de ${title}`}
						width={1600}
						height={1000}
						class="aspect-16/10 w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
						loading="lazy"
					/>
				</figure>
			)
		}

		<div class="flex min-h-0 flex-1 flex-col gap-4 p-6">
			<header>
				<h3
					id={`sample-${sample.id}-title`}
					class="text-2xl font-bold tracking-tight text-foreground"
				>
					{title}
				</h3>
				<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
					<span>{kind}</span>
					<span class="flex items-center gap-2">
						<span class="relative flex size-2 shrink-0" aria-hidden="true">
							<span
								class={'absolute -inset-1 animate-pulse rounded-full blur-sm motion-reduce:animate-none ' +
									statusInfo.glow}
							></span>
							<span class={'relative size-2 rounded-full ' + statusInfo.dot}></span>
						</span>
						{statusInfo.label}
					</span>
				</p>
			</header>

			<p class="flex-1 text-sm leading-relaxed text-muted">{description}</p>

			<footer class="mt-auto flex items-end justify-between gap-4 pt-1">
				<ul
					class="m-0 flex list-none flex-wrap gap-2 p-0"
					aria-label="Stack tecnológico"
				>
					{
						stack.map((tech) => (
							<li>
								<span class="rounded-lg border border-border bg-cloud-300 px-2.5 py-1 text-xs text-muted">
									{tech}
								</span>
							</li>
						))
					}
				</ul>
				{
					url && (
						<span class="flex shrink-0 items-center gap-1.5 text-sm font-semibold text-foreground">
							Ver sitio
							<Icon
								is:inline
								name="lucide:arrow-up-right"
								class="size-5 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
								aria-hidden="true"
							/>
							<span class="sr-only">(se abre en una pestaña nueva)</span>
						</span>
					)
				}
			</footer>
		</div>
	</Wrapper>
</article>
