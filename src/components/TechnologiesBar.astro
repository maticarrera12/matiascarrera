---
import { getCollection } from 'astro:content';

const technologies = (await getCollection('technologies')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section
	class="technologies-bar mt-8"
	aria-labelledby="technologies-heading"
>
	<h3
		id="technologies-heading"
		class="text-center text-[0.6875rem] font-medium tracking-[0.28em] text-muted uppercase"
	>
		Tecnologías que utilizo
	</h3>

	<div class="mt-2 flex justify-center overflow-x-auto">
		<ul
			class="m-0 flex w-max list-none flex-wrap items-center gap-x-8 gap-y-2 p-0"
			role="list"
		>
			{
				technologies.map((tech) => (
					<li class="flex items-center gap-3 px-2 py-5 sm:py-6">
						<img
							src={tech.data.image}
							alt=""
							width={28}
							height={28}
							class="size-7 shrink-0 rounded-full bg-foreground/20 object-contain p-1 transition-all duration-300 hover:scale-110 dark:bg-transparent"
							loading="lazy"
						/>
						<span class="whitespace-nowrap text-sm font-medium text-foreground sm:text-base">
							{tech.data.name}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
