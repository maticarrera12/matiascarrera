---
import { getCollection } from 'astro:content';

const tecnologies = (await getCollection('tecnologies')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<div class="technologies-bar mt-8">
	<p
		class="text-center text-[0.6875rem] font-medium tracking-[0.28em] text-muted uppercase"
	>
		Tecnologías que utilizo
	</p>

	<div class="mt-2 flex justify-center overflow-x-auto">
		<ul class="m-0 flex w-max list-none flex-wrap items-center gap-x-8 gap-y-2 p-0" role="list">
			{
				tecnologies.map((tech) => (
					<li>
						<div class="flex items-center gap-3 px-2 py-5 sm:py-6">
							<img
								src={tech.data.image}
								alt=""
								width={28}
								height={28}
								class="size-7 shrink-0 object-contain bg-foreground/20 dark:bg-transparent rounded-full p-1 hover:scale-110 transition-all duration-300"
								loading="lazy"
							/>
							<span class="whitespace-nowrap text-sm font-medium text-foreground sm:text-base">
								{tech.data.name}
							</span>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	
</style>
