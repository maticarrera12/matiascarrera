---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, cover, stack, type, demo, repo, status } =
	project.data;

const href = `/projects/${project.id}`;
const coverAlt = 'Captura de ' + title;

let statusDot = 'bg-zinc-500';
let statusGlow = 'bg-zinc-500/40';
if (status === 'active') {
	statusDot = 'bg-emerald-400';
	statusGlow = 'bg-emerald-400/50';
} else if (status === 'in-progress') {
	statusDot = 'bg-amber-400';
	statusGlow = 'bg-amber-400/50';
}

const stackPreview = stack.slice(0, 3);
---

<article
	class="project-card group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-cloud-100 transition-colors duration-300 hover:border-border/60"
	aria-labelledby={`project-${project.id}-title`}
>
	<a
		href={href}
		class="flex h-full min-h-0 flex-col outline-offset-4 focus-visible:outline-2 focus-visible:outline-primary"
	>
		<figure class="m-0 overflow-hidden">
			<img
				src={cover}
				alt={coverAlt}
				width={640}
				height={400}
				class="aspect-[16/10] w-full shrink-0 object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
				loading="lazy"
			/>
		</figure>

		<div class="flex min-h-0 flex-1 flex-col gap-4 p-6">
			<header>
				<h3
					id={`project-${project.id}-title`}
					class="text-2xl font-bold tracking-tight text-foreground"
				>
					{title}
				</h3>
				<p class="mt-2 flex items-center gap-2 text-sm text-muted">
					<span class="relative flex size-2 shrink-0" aria-hidden="true">
						<span
							class={'absolute -inset-1 rounded-full blur-sm animate-pulse ' +
								statusGlow}
						>
						</span>
						<span
							class={'relative size-2 rounded-full ' + statusDot}
						>
						</span>
					</span>
					{type}
				</p>
			</header>

			<p class="line-clamp-4 flex-1 text-sm leading-relaxed text-muted">
				{description}
			</p>

			<footer class="mt-auto flex items-end justify-between gap-4 pt-1">
				<ul
					class="m-0 flex list-none flex-wrap gap-2 p-0"
					aria-label="Stack tecnológico"
				>
					{
						stackPreview.map((tech) => (
							<li>
								<span class="rounded-lg border border-border bg-cloud-300 px-2.5 py-1 text-xs text-muted">
									{tech}
								</span>
							</li>
						))
					}
				</ul>
				<Icon
					is:inline
					name="lucide:arrow-right"
					class="size-5 shrink-0 text-foreground transition-transform duration-200 ease-out group-hover:translate-x-1"
					aria-hidden="true"
				/>
			</footer>
		</div>
	</a>
</article>

<style>
	/*
	 * Layered shadows à la Josh Comeau:
	 * cada capa dobla el blur y baja la opacidad,
	 * con el hue del fondo (no negro puro).
	 */
	.project-card {
		--shadow-color: 32deg 38% 18%;
		box-shadow:
			0px 1px 2px   hsl(var(--shadow-color) / 0.18),
			0px 2px 4px   hsl(var(--shadow-color) / 0.13),
			0px 4px 8px   hsl(var(--shadow-color) / 0.09),
			0px 8px 16px  hsl(var(--shadow-color) / 0.06),
			0px 16px 32px hsl(var(--shadow-color) / 0.04);
		transition:
			box-shadow 300ms ease,
			transform 300ms ease,
			border-color 300ms ease;
	}

	.project-card:hover {
		transform: translateY(-3px);
		box-shadow:
			0px 2px 4px   hsl(var(--shadow-color) / 0.22),
			0px 4px 8px   hsl(var(--shadow-color) / 0.17),
			0px 8px 16px  hsl(var(--shadow-color) / 0.13),
			0px 16px 32px hsl(var(--shadow-color) / 0.09),
			0px 24px 48px hsl(var(--shadow-color) / 0.06);
	}

	html[data-color-mode="dark"] .project-card {
		--shadow-color: 30deg 12% 4%;
	}
</style>
