---
interface Props {
	/** Optional label shown above the tabs. */
	title?: string;
	/** Tab open by default: a language id ("html"/"css"/"js") or "result". */
	defaultTab?: string;
	/** Min height of the live preview, in px. */
	previewHeight?: number;
}

const { title, defaultTab = "result", previewHeight = 220 } = Astro.props;
---

<div
	class="code-example"
	data-code-example
	data-default-tab={defaultTab}
	data-preview-height={String(previewHeight)}
	data-title={title}
>
	{title && <p class="code-example__title">{title}</p>}

	<div class="code-example__source" data-code-source>
		<slot />
	</div>
</div>

<script>
	type Block = { lang: string; label: string; code: string; el: HTMLElement };

	let ceCounter = 0;

	function normalizeLang(raw: string): { lang: string; label: string } {
		const value = (raw || "").toLowerCase();
		if (value === "js" || value === "javascript")
			return { lang: "js", label: "JS" };
		if (value === "html") return { lang: "html", label: "HTML" };
		if (value === "css") return { lang: "css", label: "CSS" };
		return { lang: value || "code", label: (raw || "CODE").toUpperCase() };
	}

	function buildSrcDoc(blocks: Block[], theme: "light" | "dark"): string {
		const find = (lang: string) =>
			blocks.find((b) => b.lang === lang)?.code ?? "";
		const css = find("css");
		const html = find("html");
		const js = find("js");
		// Defaults come BEFORE the authored CSS so demos can override them.
		// Theme follows the site (data-ce-theme), swapped via postMessage so
		// the iframe never reloads and demo JS state survives a toggle.
		return `<!doctype html>
<html lang="es" data-ce-theme="${theme}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  :root { color-scheme: light; --ce-bg: #ffffff; --ce-fg: #1a1b26; }
  :root[data-ce-theme="dark"] { color-scheme: dark; --ce-bg: #1a1b26; --ce-fg: #c0caf5; }
  html, body { background: var(--ce-bg); color: var(--ce-fg); }
  body { font-family: system-ui, sans-serif; margin: 1rem; }
${css}
</style>
</head>
<body>
${html}
<script>
  addEventListener("message", function (e) {
    if (e.data && e.data.type === "ce-theme" && (e.data.mode === "light" || e.data.mode === "dark")) {
      document.documentElement.setAttribute("data-ce-theme", e.data.mode);
    }
  });
<\/script>
<script>${js}<\/script>
</body>
</html>`;
	}

	function siteTheme(): "light" | "dark" {
		return document.documentElement.getAttribute("data-color-mode") ===
			"dark"
			? "dark"
			: "light";
	}

	function setupCodeExample(root: HTMLElement) {
		if (root.dataset.ceReady === "true") return;
		const source = root.querySelector<HTMLElement>("[data-code-source]");
		if (!source) return;

		const blockEls = Array.from(
			source.querySelectorAll<HTMLElement>("pre[data-language]"),
		);
		if (blockEls.length === 0) return;

		const blocks: Block[] = blockEls.map((el) => {
			const { lang, label } = normalizeLang(el.dataset.language ?? "");
			return { lang, label, code: el.textContent ?? "", el };
		});

		const uid = `ce-${ceCounter++}`;
		const title = root.dataset.title;
		const previewHeight = root.dataset.previewHeight ?? "220";
		const tabs = [
			...blocks.map((b) => ({ id: b.lang, label: b.label })),
			{ id: "result", label: "Resultado" },
		];
		const wanted = root.dataset.defaultTab ?? "result";
		const activeId = tabs.some((t) => t.id === wanted)
			? wanted
			: tabs[0].id;

		// Tablist
		const tablist = document.createElement("div");
		tablist.className = "code-example__tablist";
		tablist.setAttribute("role", "tablist");
		tablist.setAttribute("aria-label", title || "Ejemplo de código");

		const panels: HTMLElement[] = [];

		const makePanel = (id: string): HTMLElement => {
			const panel = document.createElement("div");
			panel.id = `${uid}-panel-${id}`;
			panel.setAttribute("role", "tabpanel");
			panel.setAttribute("aria-labelledby", `${uid}-tab-${id}`);
			panel.hidden = id !== activeId;
			return panel;
		};

		tabs.forEach((tab) => {
			const button = document.createElement("button");
			button.type = "button";
			button.id = `${uid}-tab-${tab.id}`;
			button.className = "code-example__tab";
			button.setAttribute("role", "tab");
			button.setAttribute("aria-controls", `${uid}-panel-${tab.id}`);
			button.setAttribute(
				"aria-selected",
				String(tab.id === activeId),
			);
			button.tabIndex = tab.id === activeId ? 0 : -1;
			button.textContent = tab.label;
			tablist.append(button);
		});

		// Code panels reuse the already-highlighted <pre>
		blocks.forEach((block) => {
			const panel = makePanel(block.lang);
			panel.className = "code-example__panel code-example__panel--code";
			panel.append(block.el);
			panels.push(panel);
		});

		// Result panel
		const resultPanel = makePanel("result");
		resultPanel.className =
			"code-example__panel code-example__panel--result";
		const iframe = document.createElement("iframe");
		iframe.className = "code-example__preview";
		iframe.title = title ? `Resultado: ${title}` : "Resultado del ejemplo";
		iframe.setAttribute("sandbox", "allow-scripts");
		iframe.loading = "lazy";
		iframe.style.minHeight = `${previewHeight}px`;
		iframe.srcdoc = buildSrcDoc(blocks, siteTheme());
		resultPanel.append(iframe);

		// Keep the preview in sync with the site theme without reloading it.
		const themeObserver = new MutationObserver(() => {
			iframe.contentWindow?.postMessage(
				{ type: "ce-theme", mode: siteTheme() },
				"*",
			);
		});
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["data-color-mode"],
		});
		panels.push(resultPanel);

		// Swap source for the enhanced UI
		source.remove();
		root.append(tablist, ...panels);
		root.dataset.ceReady = "true";

		const tabButtons = Array.from(
			tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
		);

		function activate(button: HTMLButtonElement, focus = true) {
			for (const b of tabButtons) {
				const selected = b === button;
				b.setAttribute("aria-selected", String(selected));
				b.tabIndex = selected ? 0 : -1;
			}
			const targetId = button.getAttribute("aria-controls");
			for (const panel of panels) panel.hidden = panel.id !== targetId;
			if (focus) button.focus();
		}

		tabButtons.forEach((button, index) => {
			button.addEventListener("click", () => activate(button, false));
			button.addEventListener("keydown", (event) => {
				let next: number | null = null;
				if (event.key === "ArrowRight")
					next = (index + 1) % tabButtons.length;
				else if (event.key === "ArrowLeft")
					next = (index - 1 + tabButtons.length) % tabButtons.length;
				else if (event.key === "Home") next = 0;
				else if (event.key === "End") next = tabButtons.length - 1;
				if (next !== null) {
					event.preventDefault();
					activate(tabButtons[next]);
				}
			});
		});
	}

	function setupAll() {
		document
			.querySelectorAll<HTMLElement>("[data-code-example]")
			.forEach(setupCodeExample);
	}

	setupAll();
	document.addEventListener("astro:after-swap", setupAll);
</script>
