---
import { AUTHOR, SOCIAL_LINKS } from "../const";
import { Icon } from "astro-icon/components";
import SocialButton from "./SocialButton.astro";
---

<section class="hero relative isolate grid w-full">
	<!-- Fondo: franja arriba (cielo + montañas) -->
	<div
		class="hero-sky pointer-events-none relative col-start-1 row-start-1 z-0 w-full self-start overflow-hidden sky-gradient"
		aria-hidden="true"
	>
		<div class="hero-sky__spacer h-24" aria-hidden="true"></div>

		<div
			class="hero-mountains relative z-1 -mt-8 flex flex-col items-center justify-end overflow-hidden"
		>
			<svg
				class="hero-mountains__svg block h-114 w-full min-w-1280 max-w-none translate-y-px overflow-visible"
				width="5120"
				height="456"
				fill="none"
				viewBox="0 0 5120 456"
				preserveAspectRatio="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					fill="var(--color-cloud-500)"
					d="M-120 456V368L0 328L256 352L512 308L768 340L1024 296L1280 332L1536 288L1792 324L2048 284L2304 318L2560 278L2816 312L3072 274L3328 306L3584 270L3840 300L4096 266L4352 294L4608 262L4864 290L5120 268L5240 300V456H-120Z"
				></path>
				<path
					fill="var(--color-cloud-300)"
					d="M-120 456V396L128 356L384 388L640 344L896 376L1152 336L1408 368L1664 328L1920 360L2176 324L2432 356L2688 320L2944 352L3200 316L3456 348L3712 312L3968 344L4224 308L4480 340L4736 304L4992 336L5240 364V456H-120Z"
				></path>
			</svg>
		</div>

		<div
			class="hero-mountains-transition pointer-events-none absolute right-0 bottom-0 left-0 z-2 flex w-full flex-col items-center justify-end overflow-hidden"
		>
			<svg
				class="hero-mountains__svg block h-114 w-full min-w-1280 max-w-none translate-y-px overflow-visible align-bottom"
				width="5120"
				height="456"
				fill="none"
				viewBox="0 0 5120 456"
				preserveAspectRatio="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					fill="var(--color-background)"
					d="M-120 456V408L256 416L512 404L768 412L1024 402L1280 410L1536 400L1792 408L2048 398L2304 406L2560 396L2816 404L3072 394L3328 402L3584 392L3840 400L4096 390L4352 398L4608 388L4864 396L5120 388L5240 404V456H-120Z"
				></path>
			</svg>
		</div>
	</div>

	<!-- Contenido encima del fondo (misma celda del grid) -->
	<div
		class="container relative z-10 col-start-1 row-start-1 -mt-8 w-full pt-20 lg:pt-48 pb-12"
	>
		<section
			class="relative z-10 mt-24 grid w-full grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12"
		>
			<div
				class="flex min-w-0 flex-col justify-between h-full gap-6 text-lg text-left"
			>
				<!-- <h1 class="sr-only">{AUTHOR.name}</h1>
				<h2 class="reveal text-6xl font-bold text-pretty text-foreground">
					Construyo productos digitales
					<span class="text-primary">
						con foco en diseño y experiencia.
					</span>
				</h2>
				<p class="reveal text-xl font-bold text-pretty text-muted">
					Desarrollador Full Stack apasionado por crear aplicaciones
					robustas, escalables y
					<span class="text-primary">centradas en las personas</span>
				</p> -->
				<div class="mb-2">
					<p class="ml6 text-2xl font-bold text-pretty text-foreground">
						<span class="text-wrapper">
							<span class="letters">Hola, soy </span><span
								class="letters text-primary">Matías.</span
							>
						</span>
					</p>
					<h1
						class="reveal text-4xl lg:text-6xl font-bold text-pretty text-foreground"
					>
						Desarrollador Web <br />
						<span
							class="text-primary font-bold text-6xl lg:text-8xl"
							>Full Stack</span
						>
					</h1>
				</div>

				<p class="reveal text-xl font-bold text-pretty text-muted">
					Vengo del diseño y migré al código. Construyo productos web
					pensados desde la experiencia, no desde el framework.
				</p>
				<div
					class="reveal flex flex-col items-start gap-4 md:flex-row md:gap-1"
				>
					<div class="flex flex-row items-start gap-4 md:gap-1">
						<a
							href="#proyectos"
							class="group/proyectos inline-flex h-15 w-fit items-center justify-center gap-2 rounded-md bg-linear-to-r from-primary to-primary/80 px-4 font-semibold text-white"
						>
							Proyectos
							<Icon
								is:inline
								name="lucide:arrow-right"
								class="size-5 transition-transform duration-200 ease-out group-hover/proyectos:translate-x-1.5"
								aria-hidden="true"
							/>
						</a>
						<a
							href="#sobre-mi"
							class="inline-flex h-15 w-fit items-center justify-center gap-2 rounded-md md:border border-foreground/70 px-4 font-semibold text-foreground/70 transition-colors hover:bg-primary/5"
						>
							Sobre Mi
						</a>
					</div>
					<div
						class="flex w-full flex-row justify-center gap-1 md:w-auto md:justify-start"
					>
						<SocialButton
							href={SOCIAL_LINKS.linkedin}
							icon="mdi:linkedin"
							label="LinkedIn"
						/>
						<SocialButton
							href={SOCIAL_LINKS.github}
							icon="mdi:github"
							label="GitHub"
						/>
						<SocialButton
							href={SOCIAL_LINKS.email}
							icon="mdi:email-outline"
							label="Email"
						/>
					</div>
				</div>
			</div>
			<div
				class="relative flex min-w-0 items-center justify-center mt-12 lg:mt-0"
			>
				{/* Glow */}
				<div
					class="absolute inset-0 bg-primary/10 blur-3xl rounded-full"
				>
				</div>

				{
					/* Main Card — en light: panel oscuro fijo para sintaxis legible */
				}
				<div
					class="code-card relative w-full overflow-hidden rounded-3xl shadow-2xl"
				>
					{/* Top bar */}
					<div
						class="code-card__chrome flex items-center gap-2 px-5 py-4"
					>
						<div class="w-3 h-3 rounded-full bg-red-400/80"></div>
						<div class="w-3 h-3 rounded-full bg-yellow-400/80">
						</div>
						<div class="w-3 h-3 rounded-full bg-green-400/80"></div>

						<div
							class="code-card__filename ml-auto text-xs font-medium"
						>
							matias.tsx
						</div>
					</div>

					{/* Content */}
					<pre
						class="overflow-x-auto p-8 font-mono text-sm leading-7"
					><code><span class="text-[#c678dd]">const</span> <span class="text-white">developer</span> <span class="text-zinc-500">=</span> <span class="text-zinc-400">{"{"}</span>
  <span class="text-[#e06c75]">name</span><span class="text-zinc-500">:</span> <span class="text-[#98c379]">'Matias Carrera'</span>,
  <span class="text-[#e06c75]">role</span><span class="text-zinc-500">:</span> <span class="text-[#98c379]">'Fullstack Developer'</span>,
  <span class="text-[#e06c75]">focus</span><span class="text-zinc-500">:</span> <span class="text-zinc-400">[</span><span class="text-[#98c379]">'UX/UI'</span>, <span class="text-[#98c379]">'Frontend'</span>, <span class="text-[#98c379]">'Product'</span><span class="text-zinc-400">]</span>,
  <span class="text-[#e06c75]">stack</span><span class="text-zinc-500">:</span> <span class="text-zinc-400">[</span><span class="text-[#98c379]">'React'</span>, <span class="text-[#98c379]">'Next.js'</span>, <span class="text-[#98c379]">'Astro'</span><span class="text-zinc-400">]</span>,
  <span class="text-[#e06c75]">currentlyBuilding</span><span class="text-zinc-500">:</span> <span class="text-[#98c379]">'mcarreradev.com'</span>,
<span class="text-zinc-400">{"}"}</span></code></pre>
				</div>
			</div>
		</section>
	</div>
</section>

<script>
	import { createTimeline, set, stagger } from "animejs";

	let tl: ReturnType<typeof createTimeline> | null = null;

	function init() {
		const root = document.querySelector<HTMLElement>(".ml6");
		if (!root) return;

		root.querySelectorAll<HTMLElement>(".letters").forEach((el) => {
			if (el.dataset.lettersWrapped) return;
			el.dataset.lettersWrapped = "1";
			el.innerHTML = el.textContent!.replace(
				/\S/g,
				"<span class='letter'>$&</span>",
			);
		});

		tl?.pause();
		tl = null;

		set(".ml6 .letter", { translateY: "1.1em" });

		tl = createTimeline({ loop: true })
			.add(".ml6 .letter", {
				translateY: 0,
				duration: 750,
				delay: stagger(50),
			})
			.add(".ml6", {
				opacity: 0,
				duration: 1000,
				ease: "outExpo",
				delay: 1000,
			})
			.add(".ml6 .letter", {
				translateY: "1.1em",
				duration: 0,
			})
			.add(".ml6", {
				opacity: 1,
				duration: 0,
			});
	}

	document.addEventListener("astro:page-load", init);
</script>

<style>
	.ml6 .text-wrapper {
		position: relative;
		display: inline-block;
		padding-top: 0.2em;
		padding-right: 0.05em;
		padding-bottom: 0.1em;
		overflow: hidden;
	}

	/* Las .letter se crean en JS — sin :global el scope de Astro no las estiliza */
	.ml6 :global(.letter) {
		display: inline-block;
		line-height: 1em;
	}
	.hero-mountains-transition path {
		pointer-events: auto;
	}

	/* Dark mode: tarjeta cristal sobre el hero */
	.code-card {
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(255 255 255 / 0.03);
		backdrop-filter: blur(24px);
	}

	.code-card__chrome {
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.code-card__filename {
		color: hsl(220 8% 58%);
	}

	/* Light mode: oscuro cálido translúcido — armoniza con el fondo */
	html[data-color-mode="light"] .code-card {
		border-color: rgb(60 35 15 / 0.20);
		background: hsl(30 18% 13% / 0.88);
		box-shadow:
			0 24px 48px -12px rgb(40 25 10 / 0.28),
			0 0 0 1px rgb(60 35 15 / 0.08);
		-webkit-backdrop-filter: blur(20px) saturate(1.15);
		backdrop-filter: blur(20px) saturate(1.15);
	}

	html[data-color-mode="light"] .code-card__chrome {
		border-bottom-color: rgb(255 220 180 / 0.08);
	}

	html[data-color-mode="light"] .code-card__filename {
		color: hsl(35 15% 68%);
	}

	@media (max-width: 50rem) {
		.hero-mountains__svg {
			--magic-number: calc(-50vw + 25rem);
			height: calc(5rem + 50vw);
			margin-top: -1rem;
			transform: translate(var(--magic-number), 1px);
		}
	}
</style>
