---
import { AUTHOR, SOCIAL_LINKS } from "../const";
import { Icon } from "astro-icon/components";
import SocialButton from "./SocialButton.astro";
---

<section class="hero relative isolate grid w-full" aria-label="Inicio">
	<!-- Fondo: franja arriba (cielo + montañas) -->
	<div
		class="hero-sky pointer-events-none relative col-start-1 row-start-1 z-0 w-full self-start overflow-hidden sky-gradient"
		aria-hidden="true"
	>
		<div class="hero-sky__spacer h-24" aria-hidden="true"></div>

		<div
			class="hero-mountains relative z-1 -mt-8 flex flex-col items-center justify-end overflow-hidden"
		>
			<svg
				class="hero-mountains__svg block h-114 w-full min-w-1280 max-w-none translate-y-px overflow-visible"
				width="5120"
				height="456"
				fill="none"
				viewBox="0 0 5120 456"
				preserveAspectRatio="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					fill="var(--color-cloud-500)"
					d="M-120 456V368L0 328L256 352L512 308L768 340L1024 296L1280 332L1536 288L1792 324L2048 284L2304 318L2560 278L2816 312L3072 274L3328 306L3584 270L3840 300L4096 266L4352 294L4608 262L4864 290L5120 268L5240 300V456H-120Z"
				></path>
				<path
					fill="var(--color-cloud-300)"
					d="M-120 456V396L128 356L384 388L640 344L896 376L1152 336L1408 368L1664 328L1920 360L2176 324L2432 356L2688 320L2944 352L3200 316L3456 348L3712 312L3968 344L4224 308L4480 340L4736 304L4992 336L5240 364V456H-120Z"
				></path>
			</svg>
		</div>

		<div
			class="hero-mountains-transition pointer-events-none absolute right-0 bottom-0 left-0 z-2 flex w-full flex-col items-center justify-end overflow-hidden"
		>
			<svg
				class="hero-mountains__svg block h-114 w-full min-w-1280 max-w-none translate-y-px overflow-visible align-bottom"
				width="5120"
				height="456"
				fill="none"
				viewBox="0 0 5120 456"
				preserveAspectRatio="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					fill="var(--color-background)"
					d="M-120 456V408L256 416L512 404L768 412L1024 402L1280 410L1536 400L1792 408L2048 398L2304 406L2560 396L2816 404L3072 394L3328 402L3584 392L3840 400L4096 390L4352 398L4608 388L4864 396L5120 388L5240 404V456H-120Z"
				></path>
			</svg>
		</div>
	</div>

	<!-- Contenido encima del fondo (misma celda del grid) -->
	<div
		class="container relative z-10 col-start-1 row-start-1 -mt-8 w-full pt-20 lg:pt-48 pb-12"
	>
		<div
			class="relative z-10 mt-24 grid w-full grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12"
		>
			<div
				class="flex h-full min-w-0 flex-col justify-between gap-6 text-left text-lg"
			>
				<!-- <h1 class="sr-only">{AUTHOR.name}</h1>
				<h2 class="reveal text-6xl font-bold text-pretty text-foreground">
					Construyo productos digitales
					<span class="text-primary">
						con foco en diseño y experiencia.
					</span>
				</h2>
				<p class="reveal text-xl font-bold text-pretty text-muted">
					Desarrollador Full Stack apasionado por crear aplicaciones
					robustas, escalables y
					<span class="text-primary">centradas en las personas</span>
				</p> -->
				<header class="mb-2">
					<p class="ml6 text-2xl font-bold text-pretty text-foreground">
						<span class="text-wrapper">
							<span class="letters">Hola, soy </span><span
								class="letters text-primary">Matías.</span
							>
						</span>
					</p>
					<h1
						class="reveal text-4xl font-bold text-pretty text-foreground lg:text-6xl"
					>
						Desarrollador Web <br />
						<span
							class="text-6xl font-bold text-primary lg:text-8xl"
							>Full Stack</span
						>
					</h1>
				</header>

				<p class="reveal text-xl font-bold text-pretty text-muted">
					Vengo del diseño y migré al código. Construyo productos web
					pensados desde la experiencia, no desde el framework.
				</p>
				<div
					class="reveal flex flex-col items-start gap-4 md:flex-row md:gap-1"
				>
					<nav aria-label="Enlaces principales">
						<ul
							class="flex list-none flex-row items-start gap-4 p-0 md:gap-1"
						>
							<li>
								<a
									href="#proyectos"
									class="group/proyectos inline-flex h-15 w-fit items-center justify-center gap-2 rounded-md bg-linear-to-r from-primary to-primary/80 px-4 font-semibold text-white"
								>
									Proyectos
									<Icon
										is:inline
										name="lucide:arrow-right"
										class="size-5 transition-transform duration-200 ease-out group-hover/proyectos:translate-x-1.5"
										aria-hidden="true"
									/>
								</a>
							</li>
							<li>
								<a
									href="#sobre-mi"
									class="inline-flex h-15 w-fit items-center justify-center gap-2 rounded-md border-foreground/70 px-4 font-semibold text-foreground/70 transition-colors hover:bg-primary/5 md:border"
								>
									Sobre Mi
								</a>
							</li>
						</ul>
					</nav>
					<nav aria-label="Redes sociales">
						<ul
							class="flex w-full list-none flex-row justify-center gap-1 p-0 md:w-auto md:justify-start"
						>
							<li>
								<SocialButton
									href={SOCIAL_LINKS.linkedin}
									icon="mdi:linkedin"
									label="LinkedIn"
								/>
							</li>
							<li>
								<SocialButton
									href={SOCIAL_LINKS.github}
									icon="mdi:github"
									label="GitHub"
								/>
							</li>
							<li>
								<SocialButton
									href={SOCIAL_LINKS.email}
									icon="mdi:email-outline"
									label="Email"
								/>
							</li>
						</ul>
					</nav>
				</div>
			</div>
			<div
				class="relative mt-12 flex min-w-0 items-center justify-center lg:mt-0"
			>
				<div
					class="absolute inset-0 rounded-full bg-primary/10 blur-3xl"
					aria-hidden="true"
				>
				</div>

				<figure
					class="code-card relative m-0 w-full overflow-hidden rounded-3xl shadow-2xl"
					aria-label="Perfil en código"
				>
					<div
						class="code-card__chrome flex items-center gap-2 px-5 py-4"
						aria-hidden="true"
					>
						<div
							class="h-3 w-3 rounded-full"
							style="background: var(--term-light-close)"
						>
						</div>
						<div
							class="h-3 w-3 rounded-full"
							style="background: var(--term-light-min)"
						>
						</div>
						<div
							class="h-3 w-3 rounded-full"
							style="background: var(--term-light-max)"
						>
						</div>

						<div class="code-card__filename ml-auto text-xs font-medium">
							matias.tsx
						</div>
					</div>

					<pre
						class="code-card__code overflow-x-auto p-8 text-sm leading-7"
					><code><span class="tok-kw">const</span> <span class="tok-var">developer</span> <span class="tok-punct">=</span> <span class="tok-bracket">{"{"}</span>
  <span class="tok-prop">name</span><span class="tok-punct">:</span> <span class="tok-str">'Matias Carrera'</span>,
  <span class="tok-prop">role</span><span class="tok-punct">:</span> <span class="tok-str">'Fullstack Developer'</span>,
  <span class="tok-prop">focus</span><span class="tok-punct">:</span> <span class="tok-bracket">[</span><span class="tok-str">'UX/UI'</span>, <span class="tok-str">'Frontend'</span>, <span class="tok-str">'Product'</span><span class="tok-bracket">]</span>,
  <span class="tok-prop">stack</span><span class="tok-punct">:</span> <span class="tok-bracket">[</span><span class="tok-str">'React'</span>, <span class="tok-str">'Next.js'</span>, <span class="tok-str">'Astro'</span><span class="tok-bracket">]</span>,
  <span class="tok-prop">currentlyBuilding</span><span class="tok-punct">:</span> <span class="tok-str">'mcarreradev.com'</span>,
<span class="tok-bracket">{"}"}</span></code></pre>
				</figure>
			</div>
		</div>
	</div>
</section>

<script>
	import { createTimeline, set, stagger } from "animejs";

	let tl: ReturnType<typeof createTimeline> | null = null;

	function init() {
		const root = document.querySelector<HTMLElement>(".ml6");
		if (!root) return;

		root.querySelectorAll<HTMLElement>(".letters").forEach((el) => {
			if (el.dataset.lettersWrapped) return;
			el.dataset.lettersWrapped = "1";
			el.innerHTML = el.textContent!.replace(
				/\S/g,
				"<span class='letter'>$&</span>",
			);
		});

		tl?.pause();
		tl = null;

		set(".ml6 .letter", { translateY: "1.1em" });

		tl = createTimeline({ loop: true })
			.add(".ml6 .letter", {
				translateY: 0,
				duration: 750,
				delay: stagger(50),
			})
			.add(".ml6", {
				opacity: 0,
				duration: 1000,
				ease: "outExpo",
				delay: 1000,
			})
			.add(".ml6 .letter", {
				translateY: "1.1em",
				duration: 0,
			})
			.add(".ml6", {
				opacity: 1,
				duration: 0,
			});
	}

	document.addEventListener("astro:page-load", init);
</script>

<style>
	.ml6 .text-wrapper {
		position: relative;
		display: inline-block;
		padding-top: 0.2em;
		padding-right: 0.05em;
		padding-bottom: 0.1em;
		overflow: hidden;
	}

	/* Las .letter se crean en JS — sin :global el scope de Astro no las estiliza */
	.ml6 :global(.letter) {
		display: inline-block;
		line-height: 1em;
	}
	.hero-mountains-transition path {
		pointer-events: auto;
	}

	/* Dark mode: tarjeta cristal sobre el hero */
	.code-card {
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(255 255 255 / 0.03);
		backdrop-filter: blur(24px);
	}

	.code-card__chrome {
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}

	.code-card__filename {
		color: hsl(220 8% 58%);
	}

	/* Syntax tokens unified with the guides consoles (tokyo-night) */
	.code-card__code {
		font-family: var(--term-font);
		color: var(--term-syntax-var);
	}

	.code-card .tok-kw {
		color: var(--term-syntax-keyword);
	}
	.code-card .tok-var {
		color: var(--term-syntax-var);
	}
	.code-card .tok-punct {
		color: var(--term-syntax-punct);
	}
	.code-card .tok-bracket {
		color: var(--term-syntax-bracket);
	}
	.code-card .tok-prop {
		color: var(--term-syntax-prop);
	}
	.code-card .tok-str {
		color: var(--term-syntax-string);
	}

	/* Light mode: frosted terminal glass — dark enough to keep the
	   tokyo-night syntax legible, but translucent so the sky shows through. */
	html[data-color-mode="light"] .code-card {
		border-color: rgb(255 255 255 / 0.12);
		background: color-mix(in srgb, var(--term-bg) 70%, transparent);
		box-shadow: 0 20px 45px -20px rgb(15 23 42 / 0.35);
		-webkit-backdrop-filter: blur(28px) saturate(1.2);
		backdrop-filter: blur(28px) saturate(1.2);
	}

	@media (max-width: 50rem) {
		.hero-mountains__svg {
			--magic-number: calc(-50vw + 25rem);
			height: calc(5rem + 50vw);
			margin-top: -1rem;
			transform: translate(var(--magic-number), 1px);
		}
	}
</style>
