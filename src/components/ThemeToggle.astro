---
interface Props {
	instanceId?: string;
}

const { instanceId = 'main' } = Astro.props;
const maskId = `theme-toggle-${instanceId}`;
const sunDots = [
	{ cx: 22, cy: 12, delay: 280 },
	{ cx: 19.0711, cy: 19.0711, delay: 200 },
	{ cx: 12, cy: 22, delay: 120 },
	{ cx: 4.9289, cy: 19.0711, delay: 40 },
	{ cx: 2, cy: 12, delay: 0 },
	{ cx: 4.9289, cy: 4.9289, delay: 80 },
	{ cx: 12, cy: 2, delay: 160 },
	{ cx: 19.0711, cy: 4.9289, delay: 240 },
] as const;
---

<button
	type="button"
	class="theme-toggle shrink-0 text-foreground hover:text-primary"
	data-theme-toggle
	aria-label="Activar modo oscuro"
>
	<svg
		width="1.25rem"
		height="1.25rem"
		viewBox="0 0 24 24"
		fill="none"
		class="theme-toggle__icon"
		aria-hidden="true"
	>
		<mask id={`${maskId}-sun-dot-mask`}>
			<rect x="-10" y="-10" width="44" height="44" fill="#fff"></rect>
			<circle r="6" cx="12" cy="12" fill="#000"></circle>
		</mask>
		<mask id={`${maskId}-moon-cutout-mask`}>
			<rect x="0" y="0" width="24" height="24" fill="#fff"></rect>
			<circle cx="12" cy="-4" r="8" fill="#000"></circle>
		</mask>

		<!-- Sol (Josh): rayos + círculo central -->
		<g class="theme-toggle__sun" mask={`url(#${maskId}-sun-dot-mask)`}>
			{
				sunDots.map((dot) => (
					<circle
						class="theme-toggle__ray"
						cx={dot.cx}
						cy={dot.cy}
						r="1.5"
						fill="currentColor"
						style={`--ray-delay: ${dot.delay}ms`}
					/>
				))
			}
		</g>
		<g class="theme-toggle__sun-body" mask={`url(#${maskId}-moon-cutout-mask)`}>
			<circle cx="12" cy="12" stroke="currentColor" fill="none" r="6"></circle>
		</g>

		<!-- Luna: media luna (contorno) -->
		<path
			class="theme-toggle__moon"
			d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			fill="none"
		/>
	</svg>
</button>
