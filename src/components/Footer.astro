---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import { AUTHOR, SOCIAL_LINKS } from '@/const';
import { CLOUD_STRIP_PATH, FOOTER_CLOUD_ACCENT_PATH } from '@/lib/cloud-strip';
import ThemeToggle from './home/ThemeToggle.astro';

const socialLinks = [
	{ href: SOCIAL_LINKS.github, icon: 'mdi:github', label: 'GitHub' },
	{ href: SOCIAL_LINKS.linkedin, icon: 'mdi:linkedin', label: 'LinkedIn' },
	{ href: SOCIAL_LINKS.twitter, icon: 'mdi:twitter', label: 'Twitter' },
	{ href: SOCIAL_LINKS.email, icon: 'mdi:email-outline', label: 'Email' },
] as const;

const firstPost = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.publishedAt.valueOf() - b.data.publishedAt.valueOf(),
)[0];
---

<footer
	class="site-footer relative flex flex-col justify-end overflow-hidden overflow-clip pt-48 sky-gradient"
>
	<svg
		class="footer-cloud-accent pointer-events-none absolute right-1/2 bottom-0 z-0 max-w-none translate-x-[86px]"
		viewBox="0 0 1557 213"
		width="1590"
		height="213"
		fill="none"
		preserveAspectRatio="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path class="footer-cloud-accent__path" d={FOOTER_CLOUD_ACCENT_PATH} />
	</svg>

	<div
		class="pointer-events-none absolute top-0 right-0 left-0 z-0 flex flex-col items-center justify-end overflow-hidden overflow-clip"
		aria-hidden="true"
	>
		<svg
			class="footer-clouds__strip relative -mt-px block w-full min-w-[5120px] max-w-none -translate-y-1 overflow-visible max-[48rem]:translate-x-[100px] max-[48rem]:translate-y-[-1px]"
			width="320rem"
			height="15.625rem"
			viewBox="0 0 5120 337"
			fill="none"
			preserveAspectRatio="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d={CLOUD_STRIP_PATH} fill="var(--color-background)" />
		</svg>
	</div>

	<div class="container relative z-10 py-8 pb-12">
		<section class="mb-16 max-w-2xl space-y-5" aria-label="Blog">
			<p class="text-2xl leading-relaxed text-foreground">
				Si llegaste hasta acá, también estoy empezando a escribir sobre mi
				camino en programación.
			</p>

			<p class="text-lg leading-8 text-muted">
				El primer post es sobre el proceso detrás de este portfolio leelo aca:
				<br />
				{
					firstPost && (
						<a
							href={`/blog/${firstPost.id}`}
							class="text-primary transition-colors hover:underline"
						>
							{firstPost.data.title}
						</a>
					)
				}
			</p>
		</section>

		<div class="flex flex-wrap items-center gap-4">
			<ThemeToggle />

			<nav aria-label="Redes sociales">
				<ul class="flex list-none items-center gap-3 p-0">
					{
						socialLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="inline-flex text-foreground transition-all duration-300 hover:scale-110 hover:text-primary"
									aria-label={link.label}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon
										is:inline
										name={link.icon}
										class="size-5"
										aria-hidden="true"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<p class="mt-4 text-sm text-muted">
			&copy; {new Date().getFullYear()} {AUTHOR.name} · Mate, café, código y
			tipografía. <span class="font-bold">Buenos Aires, Argentina</span>.
		</p>
	</div>
</footer>
