---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { AUTHOR, SOCIAL_LINKS } from '../const';

const socialLinks = [
	{ href: SOCIAL_LINKS.github, icon: 'mdi:github', label: 'GitHub' },
	{ href: SOCIAL_LINKS.linkedin, icon: 'mdi:linkedin', label: 'LinkedIn' },
	{ href: SOCIAL_LINKS.twitter, icon: 'mdi:twitter', label: 'Twitter' },
	{ href: SOCIAL_LINKS.email, icon: 'mdi:email-outline', label: 'Email' },
] as const;
---
<footer
	class="site-footer relative flex flex-col justify-end overflow-hidden overflow-clip pt-48 sky-gradient"
	role="contentinfo"
>
	<svg
		class="footer-cloud-accent pointer-events-none absolute right-1/2 bottom-0 z-0 max-w-none translate-x-[86px]"
		viewBox="0 0 1557 213"
		width="1590"
		height="213"
		fill="none"
		preserveAspectRatio="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			class="footer-cloud-accent__path"
			d="M1331 165.5C1320.5 162.5 1311 112 1221.5 92.4999C1132 72.9999 1104.5 114 1093.5 112C1082.5 110 1052 6.04351 903.5 1.00011C771 -3.49989 732.5 90 722.5 92.4999C712.5 94.9998 647.5 54.0001 535.5 73.9999C423.5 93.9997 421.5 165.5 411.5 165.5C401.5 165.5 359 58.5001 203.5 49.4999C48 40.4998 0.5 136 0.5 209.5C0.5 283 62.5 309.5 62.5 309.5H100.5L1556.5 304.5V232.5C1556.5 215.5 1542.5 159.009 1464 145.5C1368.81 129.118 1341.5 168.5 1331 165.5Z"
		></path>
	</svg>

	<div
		class="pointer-events-none absolute top-0 right-0 left-0 z-0 flex flex-col items-center justify-end overflow-hidden overflow-clip"
		aria-hidden="true"
	>
		<svg
			class="footer-clouds__strip relative -mt-px block w-full min-w-[5120px] max-w-none -translate-y-1 overflow-visible max-[48rem]:translate-x-[100px] max-[48rem]:translate-y-[-1px]"
			width="320rem"
			height="15.625rem"
			viewBox="0 0 5120 337"
			fill="none"
			preserveAspectRatio="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M2262 93C2122.5 82.5987 2116 21.5 2096.5 21.5C2077 21.5 2070.5 77.5238 1920.5 93C1794.5 106 1786 62 1771.5 63.5C1757 65 1687 155.5 1580 142C1473 128.5 1446.5 90 1435 93C1423.5 96 1448.03 199.005 1340 214C1181.5 236 1155.5 142 1144 142C1132.5 142 1105.5 269 946.5 236C787.5 203 799 115 784 114.5C769 114 732.5 162 544 158C382 154.562 352.5 81 341 84.5C329.5 88 358 269 168 326C-22 383 -75.5 180 -75.5 180V0.5H5189.5L5193.5 46C5193.5 46 5200 94 5069.5 100.5C4939 107 4923.5 21.5 4906.5 21.5C4889.5 21.5 4870 35 4835 93.5C4800 152 4765.5 169.5 4643.5 173.5C4521.5 177.5 4436.5 69 4425.5 76.5C4414.5 84 4413.5 212 4235 222C4056.5 232 4045.5 92 4033.5 89C4021.5 86 3968.5 169.5 3823.5 172.5C3678.5 175.5 3573.5 104 3562.5 106.5C3551.5 109 3553.5 167.5 3396 201C3238.5 234.5 3171.5 168.5 3161 172.5C3150.5 176.5 3164 273 3076.5 294.5C2975.99 319.197 2935 228 2920 225.5C2905 223 2862 276.955 2749 245C2671.4 223.057 2672.5 149 2660.5 151.5C2648.5 154 2622.5 181.04 2548.5 158C2425 119.548 2427.5 53.5 2412 51C2396.5 48.5 2376 101.5 2262 93Z"
				fill="var(--color-background)"
			></path>
		</svg>
	</div>

	<div class="container relative z-10 py-8 pb-12">
		<div class="flex flex-wrap items-center gap-4">
			<ThemeToggle instanceId="footer" />
			<div class="flex items-center gap-3">
				{
					socialLinks.map((link) => (
						<a
							href={link.href}
							class="inline-flex text-foreground hover:text-primary hover:scale-110 transition-all duration-300"
							aria-label={link.label}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon is:inline name={link.icon} class="size-5" aria-hidden="true" />
						</a>
					))
				}
			</div>
		</div>
		<p class="mt-4 text-sm text-muted">
			&copy; {new Date().getFullYear()}
			{AUTHOR.name}. Todos los derechos reservados.
		</p>
	</div>
</footer>
