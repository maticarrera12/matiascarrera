---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';
import TechnologiesBar from './TechnologiesBar.astro';

const projects = await getCollection('projects');
const featured = projects
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<section id="proyectos" class="container min-h-screen scroll-mt-24 py-20">
	<div class="mb-4 flex flex-row items-center gap-3">
		<span class="relative flex size-2 shrink-0" aria-hidden="true">
			<span
				class="absolute -inset-1 animate-pulse rounded-full bg-primary/50 blur-sm"
			></span>
			<span class="relative size-2 rounded-full bg-primary"></span>
		</span>
		<h5 class="text-sm font-bold text-pretty text-primary">
			Proyectos Destacados
		</h5>
	</div>

	<div
		class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center"
	>
		<h2 class="text-4xl font-bold text-pretty text-foreground md:text-6xl">
			Proyectos que diseñé <br />
			y <span class="text-primary">desarrollé</span>
		</h2>

		<!-- <a
			href="/proyectos"
			class="group/proyectos inline-flex shrink-0 items-center gap-2 rounded-md border border-foreground/70 px-4 py-4 font-semibold text-foreground transition-colors duration-200 hover:border-primary hover:bg-primary hover:text-white"
		>
			Ver Proyectos
			<Icon
				is:inline
				name="lucide:arrow-right"
				class="size-5 transition-transform duration-200 ease-out group-hover/proyectos:translate-x-1.5"
				aria-hidden="true"
			/>
		</a> -->
	</div>

	{
		featured.length > 0 ? (
			<ul class="m-0 mt-16 grid list-none grid-cols-1 items-stretch gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
				{featured.map((project) => (
					<li class="h-full">
						<ProjectCard project={project} />
					</li>
				))}
			</ul>
		) : (
			<p class="mt-16 text-muted">
				No hay proyectos destacados todavía. Marcá uno con{' '}
				<code class="text-foreground">featured: true</code> en el frontmatter.
			</p>
		)
	}

	<TechnologiesBar />
</section>
