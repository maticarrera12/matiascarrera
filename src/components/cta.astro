---
import { Icon } from "astro-icon/components";
import { AUTHOR } from "../const";

const ctaImage = "/images/projects/mre-landing-1.png";
const body = "text-xl leading-9 text-muted";
---

<section class="container py-24" aria-labelledby="cta-heading">
	<div
		class="relative h-auto overflow-hidden rounded-4xl bg-cloud-500 md:min-h-96 lg:min-h-88"
	>
		<div class="relative z-10 max-w-xl space-y-8 p-8 md:p-12 lg:p-16">
			<h2
				id="cta-heading"
				class="text-4xl font-bold leading-tight tracking-tight text-foreground md:text-5xl"
			>
				Me interesa construir productos claros, sólidos y bien pensados.
			</h2>

			<div class="space-y-4">
				<p class={body}>
					Actualmente busco mi primera experiencia profesional como
					desarrollador frontend/fullstack.
				</p>
				<p class={body}>
					Me interesa trabajar en productos reales, rodeado de personas de las
					que pueda seguir aprendiendo.
				</p>
			</div>

			<a
				href={`mailto:${AUTHOR.email}`}
				class="group inline-flex h-15 w-fit items-center justify-center gap-3 rounded-2xl bg-primary px-8 text-lg font-medium text-white transition-colors hover:bg-primary/90"
			>
				Hablemos
				<Icon
					name="mdi:arrow-right-thin"
					class="size-5 transition-transform duration-200 ease-out group-hover:translate-x-1.5"
					aria-hidden="true"
				/>
			</a>
		</div>

		<figure
			class="pointer-events-none absolute inset-y-0 right-0 m-0 hidden w-[62%] md:block lg:w-[58%]"
			aria-hidden="true"
		>
			<img
				src={ctaImage}
				alt=""
				class="absolute max-w-none rotate-[8deg] rounded-2xl shadow-2xl shadow-black/35 ring-1 ring-white/10 md:right-[-12%] md:bottom-[-14%] md:w-[120%] lg:right-[-35%] lg:bottom-[-20%] lg:w-[128%]"
				width="1200"
				height="675"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</div>
</section>
